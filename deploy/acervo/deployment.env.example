ACERVO_UID=1000
ACERVO_GID=1000
ACERVO_BIND_ADDRESS=127.0.0.1
ACERVO_ANKI_PORT=27701
ACERVO_APP_BIND_ADDRESS=127.0.0.1
ACERVO_APP_PORT=27702
ACERVO_APP_VERSION=0.1.0
ACERVO_APP_BUILD=202608270000
ACERVO_ANKI_SERVER_DATA=/opt/acervo/data/anki-server
ACERVO_WORKER_DATA=/opt/acervo/data/acervo-worker
ACERVO_DICTIONARIES=/opt/acervo/data/dictionaries
ACERVO_SERVER_DATA=/opt/acervo/data/server
# Sense images and other generated media, written by the worker and served read-only.
ACERVO_MEDIA=/opt/acervo/data/media
# The spoken-usage corpus, in two halves. The cache is downloaded captions: bandwidth spent, not
# politely re-fetchable, and the one store here that nothing deletes — neither --reset-anki nor
# --reset-database goes near it. The index is rebuilt from the cache by the server's nightly run,
# or by Update now in Settings ▸ Clips.
ACERVO_SPEECH_CACHE=/opt/acervo/data/speech-cache
ACERVO_SPEECH_INDEX=/opt/acervo/data/speech-index
# The channel list, seeded from the retrieval wheel on first start and never overwritten, so a
# channel added in Settings survives a version bump.
ACERVO_SPEECH_CATALOGUES=/opt/acervo/data/speech-catalogues
# Where the server reaches the corpus, on the compose network. The service publishes no port.
ACERVO_SPEECH_URL=http://speech-retrieval:8000/api/v1
# The zone days and the nightly hour in Settings ▸ Schedule are read in. Written by every deploy:
# `--timezone`, else the deploying machine's own zone, else the one already here. Unset means the
# container's own, which is UTC — so a nightly run set for 02:00 would happen at 03:00 or 04:00.
ACERVO_TIMEZONE=Europe/London
ACERVO_DOWNLOADS=/opt/acervo/downloads
ACERVO_INPUT_PATH=/opt/acervo/input
