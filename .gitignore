.DS_Store
.venv/
.pytest_cache/
__pycache__/
*.egg-info/
__old/
.env
*.pyc
/data/
/cache/
/output/
config/local.yaml
test-data-bkp/
checking/
old_prototypes/

# Local AI-generated visual explorations and diagnostic previews.
# Selected, app-ready assets belong under assets/ and remain tracked.
/design/generated/
/build/
# Working notes handed from one session to the next. Deliberately untracked: the design lives in
# docs/plans/, and a scratch file that got committed would become a second, staler copy of it.

# Pinned third-party artifacts fetched by scripts/fetch_speech.sh. Named and checksummed by
# deploy/acervo/speech/pin.json, which is tracked; the files themselves are not ours to commit.
/vendor/
/node_modules/
/web/node_modules/
/web/dist/
# Generated PWA staging area populated by `npm run stage:pwa` before deployment.
/deploy/acervo/server/web/*
!/deploy/acervo/server/web/.gitkeep
/DerivedData/
/macos/Acervo.xcodeproj/
/macos/Resources/Assets.xcassets/
.acervo-deploy
/deploy/acervo/llm.env
*.swp
*.swo

# Serving probe.html to a phone over https needs a local certificate and a Caddyfile in the
# experiment directory (see experiments/external-dictionaries/README.md). Neither belongs in a
# public repository — the Caddyfile carries a LAN address and the key is a private key.
Caddyfile
*.pem
*-key.pem

# Local working files that carry deployment specifics: `ingest.sh` holds the account password and
# the tailnet hostname of the live server, `TODO.txt` holds pasted terminal output with home paths,
# and `vertex-remote-config.txt` is a pasted agent report carrying a personal Google account, a GCP
# project and organization id, and home paths. All three are untracked but were not ignored, which
# is one `git add -A` away from publishing them — and it is what
# `tests/unit/test_public_repository_privacy.py` was failing on.
/ingest.sh
/TODO.txt
/vertex-remote-config.txt

# The photo-capture spike: its cached engine responses, and the local file naming which Google
# account and project it may spend.
/experiments/photo-capture/runs/
/experiments/photo-capture/.env

# The pronunciation encoding test: its audio, and the key that says which file was which. The
# write-up keeps the numbers; twenty WAVs of the same four sentences are not worth a repository.
/experiments/pronunciation-encoding/out/

# The clip-translation runs: 350-odd raw model replies per run. Every number the experiment claims
# is in its README, and re-scoring an existing run is free, so the archive is not worth a
# repository — the same call photo-capture/runs/ made.
/experiments/clip-translation/runs/

# The compose-lesson-line runs: 360 raw articles per run, plus the judge's verdicts and the review
# page built from them. Re-scoring an existing run costs nothing and every number the experiment
# claims is in its README, so the archive is not worth a repository — the same call the two above
# made. `ratings.json` and `review-key.json` go with them: the key would reveal the blind.
/experiments/compose-lesson-line/runs/

# The primary-gloss-emotion-tuning runs: raw replies per round, same call as the two above.
/experiments/primary-gloss-emotion-tuning/runs/

# The story-picture-reference run: the owner's stories, their pictures, and the key that would
# reveal the blind. The README keeps the numbers.
/experiments/story-picture-reference/out*/

/spoken_plans/

# How to reach the owner's own deployment, for a session that has to look at it: addresses,
# account names and passwords. Never tracked, and named here rather than left to a directory's rule.
/credentials.txt

# The meaning-space experiment's environment, caches and outputs, and the prototype's copy of the
# owner's own map and pictures. The committed sample is design/ui-prototype/map-data.js.
/experiments/meaning-space/.venv/
/experiments/meaning-space/out/
/design/ui-prototype/map-data.local.js
/design/ui-prototype/map-local/

/icon_idea/
