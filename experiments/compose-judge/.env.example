# Copy to .env (gitignored) and fill in. The judge refuses to call Vertex unless every value agrees
# with the ADC file and the gcloud configuration (gcp.py).
VERTEX_ACCOUNT=learner@account.example.com
VERTEX_PROJECT=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=~/.gcloud-adc/your-profile.json
CLOUDSDK_ACTIVE_CONFIG_NAME=your-gcloud-configuration
