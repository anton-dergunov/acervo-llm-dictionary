# Local credentials for this checkout. Copy to credentials.env (ignored by git) and chmod 600.
# KEY='value' lines: a shell can source it, and a script reads it line by line.

# The owner's account on the live server. Read by assets/pictures/capture.mjs.
ACERVO_SERVER_URL='https://acervo.example.com'
ACERVO_OWNER_EMAIL='learner@account.example.com'
ACERVO_OWNER_PASSWORD='change-me'

# The NAS the server runs on, for inspecting the deployment. `ssh nas` needs no password;
# the admin password is for sudo there.
NAS_HOST='server.example.com'
NAS_ADMIN_USER='admin'
NAS_ADMIN_PASSWORD='change-me'
